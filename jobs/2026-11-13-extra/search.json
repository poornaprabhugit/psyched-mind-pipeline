     ]
    },
    {
     "n": 9,
     "text": "when, where, how.",
     "queries": [
      "calendar",
      "clock",
      "map"
     ]
    },
    {
     "n": 10,
     "text": "The distraction disappeared, even though the task wasn't done.",
     "queries": [
      "woman relaxed",
      "calm breathing",
      "man relaxed smiling"
     ]
    },
    {
     "n": 11,
     "text": "So tonight, don't finish everything.",
     "queries": [
      "night city",
      "lamp night"
     ]
    },
    {
     "n": 12,
     "text": "Just write the plan.",
     "queries": [
      "writing notebook night",
      "closing notebook"
     ]
    }
   ]
  },
