    },
    {
     "n": 11,
     "text": "A better ending is why you'd choose more pain.",
     "queries": [
      "woman smiling sunset",
      "couple sunset"
     ]
    }
   ]
  },
  {
   "id": "x02",
   "lines": [
    {
     "n": 1,
     "text": "Can't switch off at night?",
     "queries": [
      "woman awake bed night",
      "insomnia",
      "man bed awake"
     ]
    },
    {
     "n": 2,
     "text": "Your to-do list is hijacking your brain.",
