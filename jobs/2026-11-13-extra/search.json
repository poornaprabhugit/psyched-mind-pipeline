      "hand in water",
      "ice water bowl",
      "ice cubes water"
     ]
    },
    {
     "n": 4,
     "text": "Then again: the same minute,",
     "queries": [
      "stopwatch",
      "clock ticking"
     ]
    },
    {
     "n": 5,
     "text": "plus thirty seconds while the water warmed slightly.",
     "queries": [
      "pouring water",
      "water ripple hand"
     ]
    },
    {
     "n": 6,
     "text": "Most chose to repeat the longer one.",
     "queries": [
      "people raising hands",
      "woman nodding"
     ]
    },
    {
     "n": 7,
     "text": "Your brain doesn't store the whole experience.",
     "queries": [
      "brain",
      "old photos memories"
     ]
    },
    {
     "n": 8,
     "text": "It keeps the worst moment",
     "queries": [
