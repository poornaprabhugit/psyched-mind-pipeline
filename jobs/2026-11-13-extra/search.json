   "lines": [
    {
     "n": 1,
     "text": "You'd choose more pain.",
     "queries": [
      "man grimace pain",
      "woman frustrated face",
      "hand ice water"
     ]
    },
    {
     "n": 2,
     "text": "Here's the strange reason.",
