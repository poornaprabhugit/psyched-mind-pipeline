      "music",
      "earphones"
     ]
    }
   ]
  },
  {
   "id": "p09",
   "lines": [
    {
     "n": 1,
     "text": "Twenty minutes in nature is enough to lower your stress hormone.",
     "queries": [
      "walking in nature",
      "forest walk",
      "park walk"
     ]
    },
    {
     "n": 2,
     "text": "City people took short nature breaks for eight weeks.",
     "queries": [
      "city street",
      "city park",
      "busy city"
     ]
    },
    {
     "n": 3,
     "text": "No phone, no workout.",
     "queries": [
      "sitting on bench park",
      "relaxing grass",
      "woman sitting nature"
     ]
    },
    {
     "n": 4,
     "text": "Their stress hormone fell about twenty percent more per hour than it normally does.",
     "queries": [
      "relaxed woman nature",
      "breathing nature",
      "calm"
     ]
    },
    {
     "n": 5,
     "text": "The best value came at twenty to thirty minutes.",
     "queries": [
      "watch time",
      "clock",
      "wristwatch"
     ]
    },
    {
     "n": 6,
     "text": "After that, gains slowed. A park counts.",
     "queries": [
