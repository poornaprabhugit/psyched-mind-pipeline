   ]
  },
  {
   "id": "p12",
   "lines": [
    {
     "n": 1,
     "text": "Say one word for fifteen seconds, and it starts to lose its meaning.",
     "queries": [
      "woman talking",
      "man talking camera",
      "mouth speaking"
     ]
    },
    {
     "n": 2,
     "text": "People repeated a word out loud, two or three times a second.",
     "queries": [
      "speaking",
      "talking",
      "lips"
     ]
    },
    {
     "n": 3,
     "text": "Afterward, the word felt less meaningful.",
     "queries": [
      "confused woman",
      "confused man",
      "thinking"
     ]
    },
    {
     "n": 4,
     "text": "Milk. Milk. Milk. Milk.",
     "queries": [
      "milk",
      "pouring milk",
      "milk glass"
     ]
    },
    {
     "n": 5,
     "text": "Scientists think your brain's response to it simply gets tired.",
     "queries": [
      "tired",
      "exhausted",
      "brain"
     ]
    },
    {
     "n": 6,
     "text": "Try it now:",
     "queries": [
      "milk bottle",
      "glass of milk",
      "milk splash"
     ]
    }
   ]
  },
  {
   "id": "p13",
   "lines": [
    {
     "n": 1,
     "text": "A loss hurts about twice as much as the same win feels good.",
     "queries": [
      "losing money",
      "sad man money",
      "disappointed"
     ]
    },
    {
     "n": 2,
     "text": "Flip a coin:",
     "queries": [
      "coin flip",
      "coin toss",
      "coin"
     ]
    },
    {
     "n": 3,
     "text": "lose a hundred dollars, or win a hundred and fifty.",
     "queries": [
      "hundred dollar bills",
      "money",
      "cash"
     ]
    },
    {
     "n": 4,
     "text": "Many people say no.",
     "queries": [
      "man shaking head",
      "no",
      "woman shaking head"
     ]
    },
    {
     "n": 5,
     "text": "Across a hundred and fifty studies, the win had to be about twice the loss.",
     "queries": [
      "scientific papers",
      "research",
      "reading papers"
     ]
    },
    {
     "n": 6,
     "text": "Your brain guards what you have more than what you could get.",
     "queries": [
      "holding wallet",
      "wallet",
      "piggy bank"
     ]
    },
    {
     "n": 7,
     "text": "That's why",
     "queries": [
      "coin spinning",
      "coin",
      "money"
     ]
    }
   ]
  },
  {
   "id": "p14",
   "lines": [
    {
     "n": 1,
     "text": "Your mind is somewhere else almost half the time you're awake.",
     "queries": [
      "daydreaming",
      "woman daydreaming",
      "man staring window"
     ]
    },
    {
     "n": 2,
     "text": "Over two thousand people got random phone pings:",
     "queries": [
      "phone notification",
      "smartphone",
      "people phone"
     ]
    },
    {
     "n": 3,
     "text": "what are you doing, and what are you thinking about?",
     "queries": [
      "thinking",
      "woman thinking",
      "man thinking"
     ]
    },
    {
     "n": 4,
     "text": "Forty-seven percent of the time, they were thinking about something else.",
     "queries": [
      "staring",
      "daydream",
      "lost in thought"
     ]
    },
    {
     "n": 5,
     "text": "And in those moments, they were less happy.",
     "queries": [
      "sad woman",
      "unhappy man",
      "bored"
     ]
    },
    {
     "n": 6,
     "text": "Even reading this, chances are",
     "queries": [
      "reading",
      "woman reading",
      "man reading"
     ]
    }
   ]
  }
 ]
