{
 "videos": [
  {
   "id": "p01",
   "lines": [
    {
     "n": 1,
     "text": "You just felt your phone buzz, and nothing was there.",
     "queries": [
      "phone vibrating table",
      "woman checking phone",
      "man pocket phone"
     ]
    },
    {
     "n": 2,
     "text": "Two out of three hospital workers said this happens to them.",
     "queries": [
      "nurse hospital corridor",
      "doctor hospital",
      "medical staff"
     ]
    },
    {
     "n": 3,
     "text": "Their brains learned to expect the buzz, so they guess.",
     "queries": [
      "woman looking at phone",
      "notification smartphone",
      "man waiting phone"
     ]
    },
    {
     "n": 4,
     "text": "A shirt moves, a muscle twitches,",
     "queries": [
      "shirt fabric close up",
      "man adjusting shirt",
      "arm muscle close up"
     ]
    },
    {
     "n": 5,
     "text": "and your brain says: message.",
     "queries": [
      "smartphone message",
      "texting hands",
      "phone screen light"
     ]
    },
    {
     "n": 6,
     "text": "It's not broken. It's trained.",
     "queries": [
      "man looking at phone confused",
      "woman puts phone down",
      "phone on table"
     ]
    },
    {
     "n": 7,
     "text": "That's why",
     "queries": [
      "phone vibrating",
      "woman pocket phone",
      "smartphone table"
     ]
    }
   ]
  },
  {
   "id": "p02",
   "lines": [
    {
     "n": 1,
     "text": "Lose ten dollars, and you still buy the ticket.",
     "queries": [
      "dollar bill falling",
      "money dropped street",
      "wallet money"
     ]
    },
    {
     "n": 2,
     "text": "Lose the ticket, and you don't.",
     "queries": [
      "ticket hand",
      "cinema ticket",
      "searching pockets"
     ]
    },
    {
     "n": 3,
     "text": "Lost a ten-dollar bill on the way to the theater?",
     "queries": [
      "theater entrance",
      "walking to theater night",
      "cinema lights"
     ]
    },
    {
     "n": 4,
     "text": "Eighty-eight percent still bought a ticket.",
     "queries": [
      "ticket office",
      "buying ticket",
      "box office"
     ]
    },
    {
     "n": 5,
     "text": "Lost the ten-dollar ticket itself? Only forty-six percent bought another.",
     "queries": [
      "man searching pockets",
      "woman looking in bag",
      "frustrated man"
     ]
    },
    {
     "n": 6,
     "text": "Same money.",
     "queries": [
      "dollar bills",
      "money counting",
      "cash hands"
     ]
    },
    {
     "n": 7,
     "text": "But your brain says the show now costs twenty. So:",
     "queries": [
      "theater stage",
      "audience theater",
      "cinema seats"
     ]
    }
   ]
  },
  {
   "id": "p03",
   "lines": [
    {
     "n": 1,
     "text": "Over half of people yawn just from watching someone yawn.",
     "queries": [
      "yawning",
      "man yawning",
      "woman yawning"
     ]
    },
    {
     "n": 2,
     "text": "People watched five minutes of yawning faces.",
     "queries": [
      "watching screen",
      "people watching video",
      "woman watching laptop"
     ]
    },
    {
     "n": 3,
     "text": "Fifty-five percent yawned.",
     "queries": [
      "tired yawn",
      "yawn office",
      "sleepy man"
     ]
    },
    {
     "n": 4,
     "text": "Five minutes of smiling faces? About one in five.",
     "queries": [
      "smiling face",
      "woman smiling",
      "man smiling"
     ]
    },
    {
     "n": 5,
     "text": "You might be yawning right now.",
     "queries": [
      "yawning woman bed",
      "sleepy woman",
      "yawn"
     ]
    },
    {
     "n": 6,
     "text": "Your brain copies what it sees before you decide to.",
     "queries": [
      "two people talking",
      "friends laughing",
      "people mirroring"
     ]
    },
    {
     "n": 7,
     "text": "That's why",
     "queries": [
      "yawning man",
      "tired yawn",
      "sleepy"
     ]
    }
   ]
  },
  {
   "id": "p04",
   "lines": [
    {
     "n": 1,
     "text": "One free chocolate with the bill, and people tip more.",
     "queries": [
      "chocolate candy",
      "restaurant bill",
      "chocolates plate"
     ]
    },
    {
     "n": 2,
     "text": "Researchers tested it in a real restaurant.",
     "queries": [
