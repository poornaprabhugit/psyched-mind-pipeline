  {
   "id": "q03",
   "lines": [
    {
     "n": 1,
     "text": "You'd probably say no to free money if the split feels unfair.",
     "queries": [
      "money split hands",
      "cash on table",
      "man refusing money"
     ]
    },
    {
     "n": 2,
     "text": "In a classic game, one person gets some money and offers you a share.",
     "queries": [
      "two people handshake money",
      "dollar bills hands",
      "business deal table"
     ]
    },
    {
     "n": 3,
     "text": "Say yes, you both get paid.",
     "queries": [
      "man counting money",
      "offering money hand",
      "cash exchange"
     ]
    },
    {
     "n": 4,
     "text": "Say no, nobody gets anything.",
     "queries": [
      "man shaking head no",
      "woman refusing",
      "hands crossed no"
     ]
    },
    {
     "n": 5,
     "text": "On average, people offer about forty percent.",
     "queries": [
      "money counting",
      "dollar bills table"
     ]
    },
    {
     "n": 6,
     "text": "Low offers often get turned down.",
     "queries": [
      "disappointed man",
      "man shaking head",
      "rejecting offer"
     ]
    },
    {
     "n": 7,
     "text": "Fair beats free. So",
     "queries": [
      "scale balance",
      "fair handshake",
      "two people talking"
     ]
    }
   ]
  },
  {
